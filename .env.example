# Slack Socket Mode credentials
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Comma-separated Slack user IDs allowed to invoke the agent
ALLOWED_SLACK_USERS=U000000000

# Auth for the `claude` CLI inside task containers. This is the ONLY auth path
# for task inference.
CLAUDE_CODE_OAUTH_TOKEN=

# Read only by the bridge-side classifier and router (Haiku). Not used for task
# inference.
ANTHROPIC_API_KEY=

# Git auth and commit identity used inside task containers
GITHUB_TOKEN=
GITHUB_USER=
GITHUB_EMAIL=

# Repo cloned when a message names no other (org/name)
ARGUS_DEFAULT_REPO=

# SQLite database path
DB_PATH=./argus.db

# Task container image tag
DOCKER_IMAGE=argus-agent:latest

# Maximum concurrent task containers
MAX_CONCURRENT_TASKS=3
